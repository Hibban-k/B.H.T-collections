# ==============================================================================
# B.H.T. Collections Environment Configuration Template
# ==============================================================================

# MongoDB Connection String (Required)
# Note: If password contains special characters like '@', percent-encode it (e.g., '@' -> '%40')
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bht_collections?retryWrites=true&w=majority

# Auth.js / NextAuth Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=your_auth_secret_here

# Base URL (for development: http://localhost:3000)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Super Admin Initial Credentials (Used by scripts/seed-admin.ts)
ADMIN_EMAIL=admin@blankethouse.ae
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Super Admin
# Production: set to your verified custom domain, including https://www.
# Both apex and WWW must be assigned to this deployment with valid TLS.
# Local development may override this with http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.blankethouse.ae

# Google Business Profile / Google Places API (Optional - fetches real Google reviews)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_business_place_id_here
