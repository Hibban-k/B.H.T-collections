# ==============================================================================
# B.H.T. Collections Environment Configuration Template
# ==============================================================================

# MongoDB Connection String (Required)
# Note: If password contains special characters like '@', percent-encode it (e.g., '@' -> '%40')
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bht_collections?retryWrites=true&w=majority

# Auth.js / NextAuth Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=your_auth_secret_here

# Base URL (for development: http://localhost:3000)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Super Admin Initial Credentials (Used by scripts/seed-admin.ts)
ADMIN_EMAIL=admin@blankethouse.ae
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Super Admin
NEXT_PUBLIC_SITE_URL=http://localhost:3000 
